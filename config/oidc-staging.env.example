# Staging OIDC preflight template. This file contains no credentials and is not
# loaded automatically. Copy the variable names into the staging secret store or
# an ignored runtime environment, then replace every <...> value before enabling
# OIDC. Do not commit the resulting environment file.

# API bootstrap secrets required by the current config parser, even when legacy
# password login is disabled. Deliver all four values from the secret manager.
G1_DATABASE_URL=<staging-postgresql-url>
API_DEMO_EMAIL=<secret-manager-reference>
API_DEMO_PASSWORD_HASH=<secret-manager-reference>
API_CURSOR_KEY=<secret-manager-reference>
API_PORT=3001
API_SESSION_TTL_MS=28800000
API_PLANNER_MODE=disabled

# Keep external writes and AI calls disabled during identity preflight.
API_NEW_RUNS_ENABLED=0
AI_PROVIDER_CALLS_ENABLED=0

# Keep this 0 in the checked-in template. Set it to 1 only in the staging
# runtime after the provider contract and secret references are reviewed.
OIDC_ENABLED=0
OIDC_ISSUER_URL=<https-issuer-and-tenant-url>
OIDC_CLIENT_ID=<staging-client-id>
OIDC_CLIENT_SECRET=<secret-manager-reference>
OIDC_REDIRECT_URI=<https-api-staging-origin>/api/v1/auth/oidc/callback
OIDC_AUDIENCE=<approved-audience>
OIDC_SCOPES=openid,profile,email
OIDC_WEB_ORIGIN=<https-web-staging-origin>
OIDC_SESSION_COOKIE_NAME=wap_session
OIDC_TRANSACTION_TTL_MS=600000
OIDC_SESSION_TTL_MS=28800000
OIDC_CLOCK_SKEW_SECONDS=60
API_LEGACY_PASSWORD_AUTH_ENABLED=0

# The API stays loopback-bound. Configure the staging reverse proxy separately
# to terminate TLS and forward only the approved web origin.
WAP_API_TARGET=http://127.0.0.1:3001
WAP_FRONTEND_ORIGIN=<https-web-staging-origin>
