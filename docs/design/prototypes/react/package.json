{
  "name": "ati-prototypes-react",
  "private": true,
  "type": "module",
  "description": "Bản React của 12 bản mẫu giao diện; dùng node_modules ở gốc repo, không cài thêm gói.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
