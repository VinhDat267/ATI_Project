{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.unit.config.ts",
    "playwright.config.ts",
    "playwright.strict.config.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts"
  ]
}
