{
  "name": "@wap/web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:dsl": "npm run build -w @wap/dsl",
    "predev": "npm run prepare:dsl",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "npm run prepare:dsl",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pretypecheck": "npm run prepare:dsl",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "pretest:unit": "npm run prepare:dsl",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test --project=fixture",
    "pretest:live": "npm run build -- --mode live",
    "test:live": "playwright test --project=live --workers=1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "@wap/dsl": "0.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
