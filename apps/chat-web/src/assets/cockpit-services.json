{
  "playbooks": [
    {
      "id": "playbook-bug-triage",
      "title": "Đồng bộ lỗi liên công cụ",
      "services": ["trello", "github", "slack"],
      "prompt": "Tạo card trên bảng Trello cho lỗi đăng nhập Google, tạo issue trên kho GitHub kèm nhãn bug và gửi thông báo vào kênh Slack của nhóm."
    },
    {
      "id": "playbook-morning-digest",
      "title": "Tổng hợp lịch họp & báo cáo nhóm",
      "services": ["calendar", "sheets", "slack"],
      "prompt": "Đọc lịch họp hôm nay trên Google Calendar, ghi danh sách cuộc họp vào bảng tính Google Sheets và gửi bản tóm tắt vào kênh Slack."
    },
    {
      "id": "playbook-ops-alert",
      "title": "Theo dõi bảng số liệu & nhắc việc",
      "services": ["sheets", "trello", "telegram"],
      "prompt": "Đọc bảng tiến độ tuần trên Google Sheets, tạo thẻ việc cần xử lý trên bảng Trello và gửi cảnh báo nhanh qua Telegram."
    },
    {
      "id": "playbook-gmail-sheets-followup",
      "title": "Đọc bảng tính & gửi email báo giá",
      "services": ["sheets", "gmail", "slack"],
      "prompt": "Đọc danh sách khách hàng trên bảng tính Google Sheets, soạn thư báo giá qua Gmail và báo tiến độ vào kênh Slack."
    },
    {
      "id": "playbook-notion-trello-slack",
      "title": "Biên bản họp Notion & giao việc",
      "services": ["notion", "trello", "slack"],
      "prompt": "Đọc trang biên bản họp mới nhất trên Notion, bóc tách các đầu việc cần làm để tạo thẻ trên bảng Trello và gửi tóm tắt vào kênh Slack của nhóm."
    }
  ],
