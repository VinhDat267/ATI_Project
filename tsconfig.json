{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@wap/db": [
        "packages/db/src/index.ts"
      ],
      "@wap/dsl": [
        "packages/dsl/src/index.ts"
      ],
      "@wap/engine": [
        "packages/engine/src/index.ts"
      ],
      "@wap/tool-schemas": [
        "packages/tool-schemas/src/index.ts"
      ],
      "@wap/tool-adapters": [
        "packages/tool-adapters/src/index.ts"
      ],
      "@wap/planner": [
        "packages/planner/src/index.ts"
      ],
      "@wap/executor": [
        "packages/executor/src/index.ts"
      ],
      "@wap/chat-api": [
        "apps/chat-api/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/dsl/src/**/*.ts",
    "packages/dsl/scripts/**/*.ts",
    "packages/dsl/tests/**/*.ts",
    "packages/db/src/**/*.ts",
    "apps/mcp-task-hub/src/**/*.ts",
    "apps/mcp-task-hub/tests/**/*.ts",
    "apps/mcp-task-hub/vitest.integration.config.ts",
    "packages/engine/src/**/*.ts",
    "packages/engine/tests/**/*.ts",
    "packages/engine/vitest.unit.config.ts",
    "packages/engine/vitest.integration.config.ts",
    "apps/api/src/**/*.ts",
    "apps/api/tests/**/*.ts",
    "apps/api/vitest.unit.config.ts",
    "apps/api/vitest.integration.config.ts",
    "packages/tool-schemas/src/**/*.ts",
    "packages/tool-schemas/tests/**/*.ts",
    "packages/tool-adapters/src/**/*.ts",
    "packages/tool-adapters/tests/**/*.ts",
    "packages/planner/src/**/*.ts",
    "packages/planner/tests/**/*.ts",
    "packages/executor/src/**/*.ts",
    "packages/executor/tests/**/*.ts",
    "apps/chat-api/src/**/*.ts",
    "apps/chat-api/tests/**/*.ts",
    "evaluations/**/*.ts",
    "tests/**/*.ts"
  ]
}
