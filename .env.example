# ==============================================================================
# AI WORKFLOW AUTOMATION PLATFORM (v3)
# ==============================================================================
# Copy to the ignored .env. Secret names are shown only as blank placeholders:
# never put values in this file, command arguments, prompts, logs, or evidence.
RUNTIME_MODE=sandbox
PORT=3000
V3_WEB_PORT=5174
# Port 1 is intentionally unreachable so a fresh sandbox uses in-memory storage.
# For live mode, set RUNTIME_MODE=live and provide every value below locally.
DATABASE_URL=postgresql://127.0.0.1:1/ati_v3
JWT_SECRET=
ENCRYPTION_KEY=
GEMINI_API_KEY=
# Planning LLM: gemini (default, uses GEMINI_API_KEY/GEMINI_MODEL) or
# openai-compatible (any /v1/chat/completions gateway such as a local 9router).
# Pin one exact model and disable gateway fallback: a completion served by a
# different model is rejected.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=
# LLM_MODEL=ag/gemini-3.8-flash
# IANA time zone for relative deadlines such as "thứ 6" (default Asia/Ho_Chi_Minh).
# APP_TIME_ZONE=Asia/Ho_Chi_Minh
# How names become IDs: llm (the model calls search tools; default in live) or regex
# (registry gather rules; default in sandbox, whose canned provider cannot search).
# PLANNER_SEARCH_MODE=llm
# Read-only answers are opt-in until the separate measurement is complete.
PLANNER_READ_ANSWERS=off
# Live-only user provisioning (choose values in the ignored .env).
CHAT_ADMIN_EMAIL=
CHAT_ADMIN_PASSWORD=
# Set both values in the ignored .env to log into the in-memory sandbox UI.
SANDBOX_USER_EMAIL=
SANDBOX_USER_PASSWORD=
# Optional dev-only demo helper; disabled by default. Uses SANDBOX_USER_* only.
# Use a separate demo account, never CHAT_ADMIN_*. With PostgreSQL, provision it first.
VITE_SHOW_DEMO_LOGIN=false
# Signup is open with email verification and admin approval; false closes it.
AUTH_SIGNUP_ENABLED=true
# Google login is available only when all three values are configured (AUTH-04).
# Register the web origin's exact /auth/google/callback URI in Google Cloud.
# Local fake endpoints are injected by test:browser:v3; live always uses Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Gmail as each member's own connection (GMAIL-01): off unless GMAIL_ENABLED=on.
# Use the OAuth client of a separate Google Cloud project, never the login client above.
# With the flag on, live refuses to start if one of the three values is missing.
# Redirect: the web origin's exact /connections/gmail/callback URI.
GMAIL_ENABLED=off
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
# Declare the real Cloud project ID when live MyCalendar is enabled (also if Gmail's flag is off).
GMAIL_OAUTH_PROJECT_ID=
# Sandbox/tests only (ignored in live): fake Google endpoints. Without all four, sandbox Gmail is off (503).
# GMAIL_OAUTH_AUTH_URL=
# GMAIL_OAUTH_TOKEN_URL=
# GMAIL_OAUTH_REVOKE_URL=
# GMAIL_API_BASE_URL=
# Google Calendar cá nhân as each member's own connection (OAUTH-02): off unless MYCALENDAR_ENABLED=on.
# Use a DIFFERENT Google Cloud project from Gmail and sign-in; another client in the same project is insufficient.
# Google revocation invalidates every client grant for the same account in that project.
# Redirect: the web origin's exact /connections/mycalendar/callback URI.
MYCALENDAR_ENABLED=off
MYCALENDAR_OAUTH_CLIENT_ID=
MYCALENDAR_OAUTH_CLIENT_SECRET=
MYCALENDAR_OAUTH_REDIRECT_URI=
MYCALENDAR_OAUTH_PROJECT_ID=
# Sandbox/tests only (ignored in live): fake Google endpoints. Without all four, sandbox MyCalendar is off (503).
# MYCALENDAR_OAUTH_AUTH_URL=
# MYCALENDAR_OAUTH_TOKEN_URL=
# MYCALENDAR_OAUTH_REVOKE_URL=
# MYCALENDAR_API_BASE_URL=
# Google Sheets của riêng bạn via Google Picker (OAUTH-03): off unless MYSHEETS_ENABLED=on.
# Use a THIRD Google Cloud project separate from Gmail, Calendar and sign-in.
# Redirect: the web origin's exact /connections/mysheets/callback URI.
MYSHEETS_ENABLED=off
MYSHEETS_OAUTH_CLIENT_ID=
MYSHEETS_OAUTH_CLIENT_SECRET=
MYSHEETS_OAUTH_REDIRECT_URI=
MYSHEETS_OAUTH_PROJECT_ID=
MYSHEETS_PICKER_API_KEY=
MYSHEETS_PICKER_APP_ID=
# Sandbox/tests only (ignored in live): fake Google endpoints. Without all four, sandbox MySheets is off (503).
# MYSHEETS_OAUTH_AUTH_URL=
# MYSHEETS_OAUTH_TOKEN_URL=
# MYSHEETS_OAUTH_REVOKE_URL=
# MYSHEETS_API_BASE_URL=
# Scheduled workflows (SCHED-01): off unless SCHEDULES_ENABLED=on. Needs PostgreSQL.
SCHEDULES_ENABLED=
# Web origin used by verification/reset emails (HTTPS required in live).
APP_BASE_URL=
# Live email requires all SMTP settings. Sandbox/CI writes email_outbox only.
# Live with no SMTP setting still starts: signup is off and the email routes answer 503.
# Setting only some of them is a startup error.
# Gmail uses smtp.gmail.com, port 465, TLS and a Gmail App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ==============================================================================
# SERVICE CREDENTIALS (optional, for local integration and controlled live runs)
# ==============================================================================
TRELLO_API_KEY=
TRELLO_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
# Controlled live execution (evaluations/live-execution/run.ts). A service is
# enabled only with its token and an allowlist of TEST resources; the adapters
# refuse anything outside it. Use a throwaway board, channel and repository.
# LIVE_TRELLO_BOARD_IDS=<board id>
# LIVE_SLACK_CHANNELS=<channel id>
# LIVE_GITHUB_REPOS=<owner>/<repo>
# Google service account for Sheets and Calendar (stored separately per service).
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# LIVE_SHEETS_SPREADSHEET_IDS=
# LIVE_CALENDAR_IDS=
# Notion internal integration; database ids, not data-source ids.
# NOTION_TOKEN=
# LIVE_NOTION_DATABASE_IDS=
# Telegram BotFather token and explicitly allowed numeric chat IDs.
# TELEGRAM_BOT_TOKEN=
# LIVE_TELEGRAM_CHAT_IDS=
# Jira Cloud Basic auth; exact https://<site>.atlassian.net and explicit project keys.
# JIRA_SITE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# LIVE_JIRA_PROJECT_KEYS=

# Notion public integration OAuth setup; independent of the shared integration token.
# Live callback: https://<web-origin>/connections/mynotion/callback
MYNOTION_ENABLED=off
MYNOTION_OAUTH_CLIENT_ID=
MYNOTION_OAUTH_CLIENT_SECRET=
MYNOTION_OAUTH_REDIRECT_URI=
