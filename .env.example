# G1 server reads environment supplied by its launcher; it does not auto-load this file.
G1_DATABASE_URL=postgresql://wap:wap@127.0.0.1:55432/wap_g1
G1_USER_ID=00000000-0000-4000-8000-000000000001
# Remaining app settings are templates. Model identifiers are unverified candidates.
# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://wap:wap@localhost:5432/wap
REDIS_URL=redis://localhost:6379

# ─── LLM ────────────────────────────────────────────────────
# Lấy key tại console.anthropic.com. KHÔNG commit file .env
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=8000

# ─── Embedding ──────────────────────────────────────────────
# Đổi model thì phải đổi EMBEDDING_DIM và chạy lại migration vector
# Chỉ dùng cho embedding tool description (xem docs/QUYET-DINH.md QĐ-02)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ─── Bảo mật ────────────────────────────────────────────────
# Sinh bằng: openssl rand -base64 32
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# ─── MCP allow-list (FR-CON-06) ─────────────────────────────
# Ngăn cách bằng dấu phẩy. Rỗng = chặn tất cả.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_PRESETS_FILE=config/mcp-presets.json
# No wildcard node/npx authorization. Presets must pin executable/package/version/args/root.

# ─── Engine ─────────────────────────────────────────────────
WORKER_INLINE=true              # true = chạy chung tiến trình API (xem CONTRIBUTING)
RUN_HEARTBEAT_MS=15000
RUN_ORPHAN_THRESHOLD_MS=60000
APPROVAL_TTL_MS=600000
MAX_PLANNING_ATTEMPTS=3
MAX_REPLANS=2
RETRIEVAL_TOP_K=5
RUNTIME_TIME_ZONE=Asia/Ho_Chi_Minh
STATUS_POLL_INTERVAL_MS=2000
TASK_HUB_MODE=local

# ─── Chế độ demo ────────────────────────────────────────────
DEMO_MODE=true                  # local dataset only; never bypass approval or erase operation receipts
