# The launchers do not auto-load this file. Copy values into a local ignored
# environment only after reviewing the loopback targets and local credentials.

# Shared local database/principal (API, task_hub, engine CLI)
G1_DATABASE_URL=postgresql://wap:wap@127.0.0.1:55532/wap_g1
G1_USER_ID=00000000-0000-4000-8000-000000000001

# API runtime: these three values are required by apps/api/src/config.ts.
# API_PORT, API_SESSION_TTL_MS, API_PLANNER_MODE, and
# API_WORKER_SHUTDOWN_TIMEOUT_MS are optional and have defaults of 3001,
# 8 hours, disabled, and 30 seconds.
API_DEMO_EMAIL=
API_DEMO_PASSWORD_HASH=
API_CURSOR_KEY=
API_PORT=3001
API_SESSION_TTL_MS=28800000
API_PLANNER_MODE=disabled
API_WORKER_SHUTDOWN_TIMEOUT_MS=30000

# OIDC is disabled for B/local by default. Enable only with a reviewed issuer,
# exact redirect URI and release-owned secret/configuration.
OIDC_ENABLED=0
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/oidc/callback
OIDC_AUDIENCE=
OIDC_SCOPES=openid,profile,email
OIDC_WEB_ORIGIN=http://127.0.0.1:5173
OIDC_SESSION_COOKIE_NAME=wap_session
OIDC_TRANSACTION_TTL_MS=600000
OIDC_SESSION_TTL_MS=28800000
OIDC_CLOCK_SKEW_SECONDS=60
# Emergency production kill switch for accepting new runs (1/on by default).
API_NEW_RUNS_ENABLED=1

# Optional local engine launch controls consumed by the current runtime.
RUNTIME_TIME_ZONE=Asia/Ho_Chi_Minh
G1_FILESYSTEM_ENABLED=0

# Web Vite dev/preview proxy (optional; these are not VITE_ client variables).
WAP_API_TARGET=http://127.0.0.1:3001
WAP_FRONTEND_ORIGIN=http://127.0.0.1:5173

# AI provider profile (non-secret). The provider adapters are transport-safe
# by default; credentials are injected only by scripts/start-ai-local.ps1.
AI_PLANNING_PROVIDER=openai
AI_PLANNING_MODEL=gpt-5.6-terra
AI_QE_PROVIDER=
AI_QE_MODEL=
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_EMBEDDING_DIMENSIONS=1536
# Retrieval composition: all_tools (default), semantic, or semantic_qe.
# Semantic modes require a prepared provenance-matched active vector index;
# the runtime fails closed instead of falling back to all_tools.
AI_RETRIEVAL_VARIANT=all_tools
# Emergency provider-call kill switch (1/on by default; 0/off blocks before fetch).
AI_PROVIDER_CALLS_ENABLED=1
AI_PLANNING_MAX_OUTPUT_TOKENS=4096
AI_QE_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=45000
AI_TRIAL_DEADLINE_MS=120000
AI_MAX_PLANNING_CALLS=3
AI_MAX_REPLAN_CALLS=2
AI_MAX_QUERY_EXPANSION_CALLS=1
AI_RESERVATION_ESTIMATE_MICROS=100000

# Secret names are intentionally shown only as blank placeholders. Do not
# put values in this file, command arguments, prompts, logs, or evidence.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Planned / not consumed by the current runtime. These belong to a future
# queue/integration; do not treat them as active config.
# BullMQ/Redis deferred by AI-00; existing compose service is unchanged.
# REDIS_URL=redis://127.0.0.1:56379
# BULLMQ_QUEUE_NAME=wap-runs
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_MAX_TOKENS=8000
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=1536
