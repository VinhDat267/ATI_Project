{
  "name": "wap",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run build:v3",
    "test": "npm run test:v3",
    "build:v3": "npm run build -w @wap/chat-web",
    "typecheck:v3": "tsc -p apps/chat-api/tsconfig.json --noEmit && tsc -p apps/chat-web/tsconfig.json --noEmit",
    "chat:dev": "npm run web:dev",
    "api:v3:dev": "npm run api:dev",
    "test:v3": "node --env-file-if-exists=.env scripts/test-v3.mjs",
    "typecheck": "npm run typecheck:v3",
    "check": "npm run typecheck:v3 && npm run test:v3 && npm run test:eval:v3 && npm run build:v3 && node scripts/test-v3-web-build-security.mjs && npm run test:launcher:v3 && node --test scripts/v3-local-env.test.mjs scripts/fake-oidc.test.mjs scripts/google-oidc-fixture.test.mjs",
    "check:local:v3": "node --env-file-if-exists=.env scripts/run-v3-local.mjs check",
    "test:browser:v3": "node --env-file-if-exists=.env scripts/test-v3-browser.mjs",
    "test:launcher:v3": "node --test scripts/start-v3.test.mjs",
    "db:up:v3": "docker compose -f compose.v3.yaml up -d --wait",
    "db:down:v3": "docker compose -f compose.v3.yaml down",
    "db:migrate:v3": "node --env-file-if-exists=.env db/v3/migrate.mjs",
    "db:migrate:local:v3": "node --env-file-if-exists=.env scripts/run-v3-local.mjs migrate",
    "admin:provision:v3": "node --env-file-if-exists=.env --import tsx apps/chat-api/src/cli/provision-user.ts",
    "admin:provision:local:v3": "node --env-file-if-exists=.env --import tsx scripts/run-v3-local.mjs provision",
    "up": "node --env-file-if-exists=.env scripts/start-v3.mjs",
    "up:local:v3": "node --env-file-if-exists=.env scripts/run-v3-local.mjs up",
    "api:dev": "node --env-file-if-exists=.env --import tsx apps/chat-api/src/server.ts",
    "api:start": "npm run api:dev",
    "web:dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js apps/chat-web --host 127.0.0.1 --strictPort",
    "test:eval:v3": "vitest run evaluations"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  }
}
